{
  "expo": {
    "name": "AIDance Lab",
    "slug": "aidance-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AIDance Lab uses the camera for follow-practice feedback.",
        "NSPhotoLibraryUsageDescription": "AIDance Lab uses your videos for dance analysis.",
        "NSPhotoLibraryAddUsageDescription": "AIDance Lab can save processed dance clips when requested."
      },
      "bundleIdentifier": "com.anonymous.aidance-lab"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "AIDance Lab uses your videos for dance analysis."
        }
      ]
    ]
  }
}
